# Base URL used for canonical/Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API (not required while the mock data layer is active).
NEXT_PUBLIC_QMS_API_BASE=https://api.acme.example/qms
QMS_API_KEY=replace-me-with-a-real-secret

# Feature flags
NEXT_PUBLIC_ENABLE_MOCK_DATA=true
